import os
import pandas as pd
import shutil
import yaml
from shlex import quote
from typing import Tuple
from snakemake.utils import validate

####
# This workflow is optimized to process single-end reads prepared with Takara SMART-Seq mRNA LP kit. QC, trimming, and alignment is performed by default.
# Optionally, selection of low-duplicated reads, TIN score calculation, and Mismatch mutation quantification with rnaseqmut can be done - uncomment respective sections in the rule "finish"
####

localrules:  finish

# Get sample table
samples = pd.read_csv(
    config["samples_file"],
    header=0,
    index_col=None,
    comment='#',
    engine='python',
    sep="\t")
samples = samples.drop_duplicates('sample').reset_index(drop=True)
samples.index = samples['sample']

rule finish:
    input:
        ###
        # quality checks on fastq files
        ###
        ### 0: Input reads
        fastqc_input=expand(os.path.join(
            config["output_dir"],
            "fastqc",
            "0.input.R1",
            "{sample}"),
        sample = list(samples.index.values)),
        ### 1: Trimmed reads (remove TruSeq adapter at 3'end)
        fastqc_trimmed=expand(os.path.join(
            config["output_dir"],
            "fastqc",
            "1.trimmed_adapters.R1",
            "{sample}"),
        sample = list(samples.index.values)),
        ##
        # make genomic alignment with STAR and merge technical replicates
        ## 
        genomic_alignment_bam=expand(os.path.join(
                        config["output_dir"],
                        "map_genome_merged",
                        "{merged_sample}.merged.sorted.bam"),
        merged_sample = list(samples['merged_sample'].unique())), 
        
        ### diagnostic stats on read mapping
        mapping_stats=expand(os.path.join(
            config["output_dir"],
            "mapping_stats",
            "{sample}.mapping_stats.txt"),
        sample = list(samples.index.values)),

rule index_genome:
    """
        use samtools to index genome
    """
    input:
        genome = config["genome_file"],
    output:
        genome_fai = config["genome_file"]+'.fai'
    conda:
        "envs/samtools_latest.yaml"
    threads: 12
    resources:
        mem_mb=80000,
        runtime=240,
    log:
        os.path.join(config["local_log"],"index_genome.log"),
    shell:
        """(set +o pipefail; \
        samtools faidx -@ {threads} {input.genome}) \
        &> {log}"""

rule fastqc_input:
    """
        A quality control tool for high throughput sequence data
    """
    input:
        reads_R1=lambda wildcards: samples.loc[wildcards.sample, "fq1"],
    output:
        outdir_R1=directory(os.path.join(
            config["output_dir"],
            "fastqc",
            "0.input.R1",
            "{sample}")),
    threads: 4
    resources:
        mem_mb=10000,
        runtime=29,
        qos='30min'
    singularity:
        "docker://staphb/fastqc:0.12.1"
    log:
        os.path.join(config["local_log"],"fastqc_input__{sample}.log")
    shell:
        """(set +o pipefail; mkdir -p {output.outdir_R1}; \
        fastqc --outdir {output.outdir_R1} \
        --threads {threads} \
        {input.reads_R1}; ) \
        &> {log}"""

rule remove_adapters:
    """
        Remove adapters
    """
    input:
        reads_R1 = lambda wildcards: samples.loc[wildcards.sample, "fq1"],
    output:
        trimmed_reads_R1 = os.path.join(
            config["output_dir"],
            "fastq",
            "1.trimmed_adapters",            
            "{sample}.R1.fastq.gz"),
    params:
        outdir = os.path.join(
            config["output_dir"],
            "fastq",
            "1.trimmed_adapters"),

        adapters_3_R1=lambda wildcards: samples.loc[wildcards.sample, "fq1_3p"],

    conda:
        "envs/cutadapt.yaml"
    threads: 10
    resources:
        mem_mb=50000,
        runtime=300,
    log:
        os.path.join(config["local_log"],"remove_adapters__{sample}.log")
    shell:
        """(mkdir -p {params.outdir}; \
        cutadapt -m 1 -j {threads} -a {params.adapters_3_R1} -o {output.trimmed_reads_R1} {input.reads_R1};) \
        &> {log}"""

rule fastqc_remove_adapters:
    """
        A quality control tool for high throughput sequence data
    """
    input:
        reads_R1=os.path.join(
            config["output_dir"],
            "fastq",
            "1.trimmed_adapters",            
            "{sample}.R1.fastq.gz"),
    output:
        outdir_R1=directory(os.path.join(
            config["output_dir"],
            "fastqc",
            "1.trimmed_adapters.R1",
            "{sample}")),
    params:
        orig_reads_R1 = lambda wildcards: samples.loc[wildcards.sample, "fq1"],

rule count_UM_MM_Total_reads:
    """
        Count the abundance of UM/MM reads after mapping
        write to the ouput text file, line after line
    """
    input:
        bam_genome=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.Aligned.sortedByCoord.out.no_secondary.bam",
        ),
        input_reads=os.path.join(
            config["output_dir"],
            "fastq",
            "1.trimmed_adapters",
            "{sample}.R1.fastq.gz"),
    output:
        mapping_stats=os.path.join(
            config["output_dir"],
            "mapping_stats",
            "{sample}.mapping_stats.txt",
        ),
        success_flag=os.path.join(
            config["output_dir"],
            "mapping_stats",
            "{sample}.success",
        ),
    params:
        outdir = os.path.join(
            config["output_dir"],
            "mapping_stats"),
    conda:
        "envs/samtools_latest.yaml"
    threads: 4
    resources:
        mem_mb=20000,
        runtime=60,
    log:
        os.path.join(config["local_log"],"count_UM_MM_Total_reads_{sample}.log")
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        rm -f {output.success_flag}; \
        echo '>number of UM reads; genomic mapping' > {output.mapping_stats}; \
        samtools view -@ {threads} -q 255 {input.bam_genome} | cut -f1 | sort | uniq | wc -l >> {output.mapping_stats}; \
        echo '>total number of mapped reads; genomic mapping' >> {output.mapping_stats}; \
        samtools view -@ {threads} {input.bam_genome} | cut -f1 | sort | uniq | wc -l >> {output.mapping_stats}; \
        echo '>total number of input reads' >> {output.mapping_stats}; \
        zcat {input.input_reads} | seqkit stats -T | cut -f4 | tail -n 1 >> {output.mapping_stats}; \
        echo 'success' > {output.success_flag}; \
        ) &> {log}"""
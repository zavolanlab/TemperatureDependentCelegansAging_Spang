rule create_index_star:
    """
        Create index for STAR alignments
    """
    input:
        genome=config["genome_file"],
        gtf = config["gtf_file"],
    output:
        chromosome_info=os.path.join(
            config["output_dir"],
            "STAR_indices",
            config["organism"],
            "with_GTF",
            "STAR_index",
            "chrNameLength.txt",
        ),
        chromosomes_names=os.path.join(
            config["output_dir"],
            "STAR_indices",
            config["organism"],
            "with_GTF",
            "STAR_index",
            "chrName.txt",
        ),
    params:
        output_dir=lambda wildcards, output: os.path.dirname(output.chromosome_info),
        outFileNamePrefix=os.path.join(
            config["output_dir"],"STAR_indices", config["organism"], "with_GTF", "STAR_index/STAR_"
        ),
        sjdbOverhang = 100
    conda:
        "envs/STAR.yaml"
    threads: 16
    resources:
        mem_mb=80000,
        runtime=300,
    log:
        os.path.join(config["local_log"],"create_index_star.log"),
    shell:
        """(mkdir -p {params.output_dir}; \
        STAR \
        --runMode genomeGenerate \
        --genomeDir {params.output_dir} \
        --genomeFastaFiles {input.genome} \
        --runThreadN {threads} \
        --outFileNamePrefix {params.outFileNamePrefix} \
        --sjdbGTFfile {input.gtf}) \
        &> {log}"""

rule map_genome_star:
    """
        Map to genome using STAR
        
    """
    input:
        chromosome_info = os.path.join(
            config["output_dir"],
            "STAR_indices",
            config["organism"],
            "with_GTF",
            "STAR_index",
            "chrNameLength.txt",
        ),
        reads=os.path.join(
            config["output_dir"],
            "fastq",
            "1.trimmed_adapters",            
            "{sample}.R1.fastq.gz"),
    output:
        bam=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.Aligned.sortedByCoord.out.bam",
        ),
        bai=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.Aligned.sortedByCoord.out.bam.bai",
        ),
        log_final_file=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.Log.final.out",
        ),
    params:
        outdir = os.path.join(
            config["output_dir"],
            "map_genome"),
        STAR_index_dir = lambda wildcards, input: os.path.dirname(input.chromosome_info),
        outFileNamePrefix=lambda wildcards, output: output.bam.replace(
            "Aligned.sortedByCoord.out.bam", ""
        ),       
    conda:
        "envs/STAR.yaml"
    threads: 12
    resources:
        mem_mb=80000,
        runtime=1000,
    log:
        os.path.join(config["local_log"],"map_genome_star__{sample}.log")
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        STAR \
        --runMode alignReads \
        --alignEndsType Local \
        --runThreadN {threads} \
        --genomeDir {params.STAR_index_dir} \
        --readFilesIn {input.reads} \
        --readFilesCommand zcat \
        --outFileNamePrefix {params.outFileNamePrefix} \
        --genomeLoad NoSharedMemory \
        --outSAMtype BAM SortedByCoordinate \
        --outFilterType BySJout \
        --outFilterMismatchNoverLmax 0.3 \
        --outFilterMatchNmin 15 \
        --outFilterScoreMinOverLread 0  \
        --outFilterMatchNminOverLread 0 \
        --twopassMode None \
        --outBAMsortingThreadN {threads} \
        --alignTranscriptsPerReadNmax 50000 \
        --winAnchorMultimapNmax 50000 \
        --outFilterMultimapNmax 50000 \
        --outSAMprimaryFlag AllBestScore \
        --outSAMattributes NH HI AS nM MD \
        --limitOutSJcollapsed 5000000 \
        --limitBAMsortRAM 15000000000 \
        --limitOutSAMoneReadBytes 30000000 && \
        samtools index -@ {threads} {output.bam}) \
        &> {log}"""

### remove secondary alignments

rule samtools_remove_secondary:
    """
        index bam files
    """
    input:
        bam=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.Aligned.sortedByCoord.out.bam",
        ),
        bai=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.Aligned.sortedByCoord.out.bam.bai",
        ),
    output:
        filtered_bam=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.Aligned.sortedByCoord.out.no_secondary.bam",
        ),
        filtered_bai=os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.Aligned.sortedByCoord.out.no_secondary.bam.bai",
        ),
    conda:
        "envs/samtools_latest.yaml"
    threads: 12
    resources:
        mem_mb=20000,
        runtime=60,
    log:
        os.path.join(config["local_log"],"samtools_remove_secondary_{sample}.log")
    shell:
        """(samtools view -h -u -F 0x100 {input.bam} | samtools sort -@ {threads} -o {output.filtered_bam} && \
        samtools index -@ {threads} {output.filtered_bam}; ) &> {log}"""

### merge technical replicates

rule merge_technical_replicates:
    """
        merge technical replicates
    """
    input:
        bam=lambda wildcards: expand(os.path.join(
            config["output_dir"],
            "map_genome",
            "{sample}.Aligned.sortedByCoord.out.no_secondary.bam",
        ),
        sample = list(samples.loc[samples['merged_sample']==wildcards.merged_sample]['sample'])),
    output:
        merged_bam=os.path.join(
                        config["output_dir"],
                        "map_genome_merged",
                        "{merged_sample}.merged.sorted.bam"),
    params:
        merged_nonsorted_bam = os.path.join(
                        config["output_dir"],
                        "map_genome_merged",
                        "{merged_sample}.merged.nonsorted.bam"),
        merged_sample = "{merged_sample}",
        outdir = os.path.join(
           config["output_dir"],
                        "map_genome_merged"),
        merged_bai=os.path.join(
                        config["output_dir"],
                        "map_genome_merged",
                        "{merged_sample}.merged.sorted.bam.bai"),
    conda:
        "envs/samtools_latest.yaml"
    threads: 8
    log:
        os.path.join(config["local_log"],"merge_technical_replicates_{merged_sample}.log"),
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        k=0; for i in {input.bam}; do k=$(( $k+1 )); done; \
        if [[ $k > 1 ]]; then \
        samtools merge {params.merged_nonsorted_bam} {input.bam} -f -@ {threads}; \
        samtools sort -@ {threads} {params.merged_nonsorted_bam} > {output.merged_bam}; \
        samtools index -@ {threads} {output.merged_bam}; \
        rm {params.merged_nonsorted_bam}; \
        else \
        rm -f {output.merged_bam} && ln -f -s {input.bam} {output.merged_bam}; \
        rm -f {params.merged_bai} && ln -f -s {input.bam}.bai {params.merged_bai}; \
        fi; \
        ) &> {log}"""

    resources:
        mem_mb=10000,
        runtime=60,
    singularity:
        "docker://staphb/fastqc:0.12.1"
    log:
        os.path.join(config["local_log"],"fastqc_remove_adapters__{sample}.log")
    shell:
        """(set +o pipefail; mkdir -p {output.outdir_R1}; \
        fastqc --outdir {output.outdir_R1} --threads {threads} {input.reads_R1}; ) \
        &> {log}"""


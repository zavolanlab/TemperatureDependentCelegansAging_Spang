# ##############################################################################
# ### Gene counts using FeatureCounts
# ##############################################################################

rule FeatureCounts_standard:
    """
    perform standard gene expression quantification using provided .gtf file
    assume unstanded data
    """
    input:
        bam=os.path.join(
                        config["output_dir"],
                        "map_genome_merged",
                        "{merged_sample}.merged.sorted.bam"),
        gtf = config['gtf_file'],
    params:
        outdir = os.path.join(config['output_dir'], 
                              "gene_expression_quantification", 
                              config["organism"],"FeatureCounts_standard"),
    output:
        out_gene_fragments_txt = os.path.join(config['output_dir'], 
                                              "gene_expression_quantification", 
                                              config["organism"],
                                              "FeatureCounts_standard",
                                              "{merged_sample}.standard.txt"),
    conda:
        "envs/FeatureCounts.yaml"
    threads:8
    resources:
        mem_mb=10000,
        runtime=60,
    log:
        os.path.join(config["local_log"],"FeatureCounts_standard_{merged_sample}.log")
    shell:
        """(set +o pipefail; mkdir -p {params.outdir}; \
        featureCounts -O \
        --fraction -Q 255 -s 0 -d 1 -D 10000000000000 -T {threads} -t exon -g gene_id \
        -a {input.gtf} -o {output.out_gene_fragments_txt} {input.bam}) &> {log}"""
